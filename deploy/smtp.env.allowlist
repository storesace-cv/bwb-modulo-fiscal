# Allowlist for /etc/bwb-modulo-fiscal/smtp.env (root:root 0600).
# Loaded by systemd as optional EnvironmentFile for fiscal-api (implicit TLS only).
# Values are never logged by deploy scripts. Never commit real credentials.

FISCAL_SMTP_HOST
FISCAL_SMTP_PORT
FISCAL_SMTP_USERNAME
FISCAL_SMTP_PASSWORD
FISCAL_SMTP_TLS_MODE
FISCAL_SMTP_FROM_ADDRESS
FISCAL_SMTP_FROM_NAME
FISCAL_SMTP_ADMIN_NOTIFICATION_EMAIL
